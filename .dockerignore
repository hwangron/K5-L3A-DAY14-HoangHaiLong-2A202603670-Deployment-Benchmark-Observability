# Files NOT copied into Docker images (smaller build context, better security).
# Keep this file ASCII-only: Railway's builder rejects non-ASCII characters here.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environment
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets - IMPORTANT: never put .env into an image
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# Docs and tests
*.md
tests/
docs/
