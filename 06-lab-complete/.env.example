# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị thật.
# File .env nằm trong .gitignore — KHÔNG commit. Trên cloud đặt các biến này trên dashboard.

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — tạo key ngẫu nhiên, vd: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis (docker compose tự ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
