# NOTE: keep this file ASCII-only. Railway's builder sends these patterns in an
# HTTP header and rejects non-ASCII characters (even inside comments).

# Secrets - never copy into the image
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtualenv
venv/
.venv/
env/

# Git, IDE, OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Not needed at runtime
*.md
benchmark-observability/
check_production_ready.py
docker-compose.yml
Dockerfile
.dockerignore
railway.toml
render.yaml
